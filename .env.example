# Discord bot token from the Developer Portal. Never commit the real value.
DISCORD_TOKEN=

# The single guild this bot serves. Slash commands are registered to it.
GUILD_ID=

# SQLite database path. Relative paths resolve from the working directory.
DATABASE_PATH=ricebot.db

# Channels and categories are not set here. Run /config in the guild, which
# writes them to the settings table and takes effect without a restart.
