# Discord bot token from the Developer Portal. Never commit the real value.
DISCORD_TOKEN=

# The single guild this bot serves.
GUILD_ID=

# Book club announcements and reminders.
BOOKCLUB_CHANNEL_ID=

# CTF contest announcements.
CTF_ANNOUNCE_CHANNEL_ID=

# Category that per-contest discussion channels are created under.
CTF_CATEGORY_ID=

# Category that finished contest channels are moved to.
CTF_ARCHIVE_CATEGORY_ID=

# SQLite database path. Relative paths resolve from the working directory.
DATABASE_PATH=ricebot.db
